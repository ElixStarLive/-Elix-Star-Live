# ═══════════════════════════════════════════════════════════════════
# Store / Capacitor client build (vite --mode store)
# Copy to .env.store locally for Android/iOS store builds.
# NEVER put server secrets (JWT, Stripe secret, LiveKit secret, DB) here.
# ═══════════════════════════════════════════════════════════════════

# Public API origin used by the native WebView
VITE_API_URL=https://www.elixstarlive.co.uk
VITE_WS_URL=wss://www.elixstarlive.co.uk
VITE_LIVEKIT_URL=wss://elix-star-live-851x9jnp.livekit.cloud
VITE_BUNNY_CDN_HOSTNAME=elixstorage.b-cdn.net
VITE_BUNNY_STORAGE_ZONE=elix-storage
VITE_CDN_URL=https://elixstorage.b-cdn.net
VITE_APP_NAME=Elix Star Live

# Native builds bake these in: /env.js is a local (empty) asset inside the
# WebView, so the server cannot supply them at runtime the way it does on web.
# Omitting VITE_EMAIL_CONFIGURED hides Forgot Password in the shipped app.
VITE_APPLE_SIGN_IN_ENABLED=false
VITE_EMAIL_CONFIGURED=true

# Stripe publishable key only (shop web checkout) — never the secret key
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Test coins stay in the app: battle score + gift animation only (£0).
# Never IAP / Stripe / real wallet / creator payout. Mint is admin + password.
# Set to 0 only to hide the spectator control.
VITE_ALLOW_TEST_COINS=1

# Optional crash reporting for store builds
# VITE_ENABLE_CRASH_REPORTING=true
