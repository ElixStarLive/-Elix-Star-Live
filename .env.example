# Server configuration. Every value below is required — the process refuses to
# start if one is missing or malformed, rather than substituting a default.
# Copy to `.env` and fill in the NEW environment's credentials. Never commit `.env`.

NODE_ENV=development
PORT=8787

# Neon Postgres connection string for the NEW database (not the old one).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Valkey connection string. Sessions and login rate limiting depend on it.
VALKEY_URL=rediss://default:password@host:6379

# HS256 signing secret, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Absolute origin of the web app, used to build links inside emails.
APP_ORIGIN=http://localhost:5173

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173
