node_modules
# .dockerignore is not .gitignore: a bare pattern matches only at the context
# root, so `node_modules` above does not exclude a nested install. Any
# server/node_modules in the working tree would be copied by `COPY . .`, land in
# the runner stage via `COPY /app/server`, survive `npm prune --omit=dev`, and
# then win Node resolution over the locked root install.
**/node_modules
dist
.git
.env
.env.*
!.env.example
.DS_Store
android
ios
coverage
_audit
_aab_peek
.cursor
.vscode
*.aab
*.apk
*.apks
*.keystore
*.jks
# Credential material .gitignore already blocks from the repo. The builder stage
# does `COPY . .`, so an untracked key sitting in the working tree would still be
# baked into that layer and be recoverable from the image history.
*.pem
*.key
*.p8
*.p12
*.mobileprovision
service-account*.json
google-service-account*.json
backups/
local-backups/
local-save/
Saved_Files/
tools/_audit/
.varmem
loadtest
docs
agent-transcripts
**/*.md
!package.json
*.log
npm-debug.log*
.turbo
.cache
playwright-report
test-results
src/**/*.test.*
src/**/*.spec.*
vitest*.ts
eslint.config.*
capacitor.config.*
