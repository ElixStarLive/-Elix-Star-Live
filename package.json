{
  "name": "elix-star-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "check": "tsc -b --noEmit",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "check:all": "npm run check && npm run check:server",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "tsx server/scripts/migrate.cli.ts",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "cookie": "1.0.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jose": "6.1.0",
    "lucide-react": "0.511.0",
    "nodemailer": "^7.0.6",
    "pg": "8.16.3",
    "pino": "9.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.9.5",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.18.9",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "8.15.5",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "globals": "15.15.0",
    "pino-pretty": "13.1.2",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
